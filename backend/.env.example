PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/pgmate
# Leave MONGODB_URI empty or unset in local dev to automatically start the built-in in-memory MongoDB!

JWT_SECRET=pgmate_super_secret_jwt_key_2026_secured_for_production
JWT_EXPIRE=7d

# Frontend URL
CLIENT_URL=http://localhost:5173

# Payment Gateway (Hyperswitch / Indian Provider)
PAYMENT_PROVIDER=sandbox
HYPERSWITCH_API_KEY=test_hyperswitch_api_key_sample
HYPERSWITCH_MERCHANT_ID=pgmate_merchant_india
HYPERSWITCH_BASE_URL=https://sandbox.hyperswitch.io
HYPERSWITCH_WEBHOOK_SECRET=test_hyperswitch_webhook_secret

# Cloudinary (Optional - local fallback storage is used when not provided)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Cloud Messaging (Optional push notifications)
FCM_SERVER_KEY=
